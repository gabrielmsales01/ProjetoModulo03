
<h2 class="sr-only">Dashboard de monitoramento de falhas de conexão com banco de dados</h2>

<style>
  .db-wrap { font-family: var(--font-sans); padding: 0; }
  .topbar { background: #1a1f2e; border-radius: var(--border-radius-lg); padding: 14px 20px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .topbar-left { display: flex; align-items: center; gap: 12px; }
  .topbar-logo { background: #3B6D11; color: #C0DD97; font-size: 13px; font-weight: 500; padding: 6px 12px; border-radius: var(--border-radius-md); }
  .topbar-title { color: #fff; font-size: 15px; font-weight: 500; }
  .topbar-sub { color: #9ca3af; font-size: 12px; }
  .status-pill { display: flex; align-items: center; gap: 6px; background: #0F6E56; color: #9FE1CB; font-size: 12px; padding: 6px 12px; border-radius: 999px; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #5DCAA5; }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-bottom: 16px; }
  .metric { background: var(--color-background-secondary); border-radius: var(--border-radius-md); padding: 14px 16px; }
  .metric-label { font-size: 12px; color: var(--color-text-secondary); margin-bottom: 6px; }
  .metric-value { font-size: 22px; font-weight: 500; color: var(--color-text-primary); }
  .metric-value.ok { color: #0F6E56; }
  .metric-value.warn { color: #854F0B; }
  .metric-value.err { color: #A32D2D; }
  .metric-badge { font-size: 11px; margin-top: 4px; }
  .panels { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
  .card { background: var(--color-background-primary); border: 0.5px solid var(--color-border-tertiary); border-radius: var(--border-radius-lg); padding: 16px; }
  .card-title { font-size: 13px; font-weight: 500; color: var(--color-text-secondary); margin-bottom: 12px; display: flex; align-items: center; gap: 6px; }
  .bar-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .bar-label { font-size: 12px; color: var(--color-text-secondary); width: 64px; flex-shrink: 0; }
  .bar-track { flex: 1; height: 8px; background: var(--color-background-secondary); border-radius: 4px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 4px; }
  .bar-val { font-size: 12px; color: var(--color-text-primary); width: 32px; text-align: right; }
  .log-list { display: flex; flex-direction: column; gap: 8px; }
  .log-item { display: flex; align-items: flex-start; gap: 10px; padding: 8px 10px; border-radius: var(--border-radius-md); background: var(--color-background-secondary); }
  .log-icon { font-size: 16px; margin-top: 1px; }
  .log-text { font-size: 12px; color: var(--color-text-primary); line-height: 1.4; }
  .log-time { font-size: 11px; color: var(--color-text-secondary); }
  .log-ok { border-left: 2px solid #1D9E75; }
  .log-err { border-left: 2px solid #E24B4A; }
  .log-warn { border-left: 2px solid #BA7517; }
  .actions { display: flex; gap: 10px; margin-bottom: 4px; flex-wrap: wrap; }
  .btn-main { background: #0F6E56; color: #E1F5EE; border: none; border-radius: var(--border-radius-md); padding: 10px 18px; font-size: 13px; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 6px; }
  .btn-sec { background: var(--color-background-secondary); color: var(--color-text-primary); border: 0.5px solid var(--color-border-secondary); border-radius: var(--border-radius-md); padding: 10px 18px; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 6px; }
  .conn-list { display: flex; flex-direction: column; gap: 8px; }
  .conn-item { display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border-radius: var(--border-radius-md); background: var(--color-background-secondary); }
  .conn-name { font-size: 13px; color: var(--color-text-primary); font-weight: 500; }
  .conn-host { font-size: 11px; color: var(--color-text-secondary); }
  .badge { font-size: 11px; padding: 3px 10px; border-radius: 999px; font-weight: 500; }
  .badge-ok { background: #E1F5EE; color: #0F6E56; }
  .badge-err { background: #FCEBEB; color: #A32D2D; }
  .badge-rec { background: #FAEEDA; color: #854F0B; }
  .latency-bar { display: flex; align-items: flex-end; gap: 4px; height: 60px; margin-top: 8px; }
  .lb { flex: 1; border-radius: 3px 3px 0 0; }
  .lb-ok { background: #1D9E75; }
  .lb-err { background: #E24B4A; }
  .lb-warn { background: #EF9F27; }
  .lb-labels { display: flex; justify-content: space-between; margin-top: 4px; }
  .lb-label { font-size: 10px; color: var(--color-text-secondary); flex: 1; text-align: center; }
</style>

<div class="db-wrap">

